FROM node:24-bookworm-slim

RUN npm install --global --registry=https://registry.npmmirror.com \
    --allow-scripts=pnpm,@deepseek-ai/dsh-subprocess-local,koffi,node-pty,@google/genai,protobufjs \
    pnpm @deepseek-ai/dsh@0.2.2-rc.1

# This optional platform package is required by DSH's host bootstrap. Fetch it
# directly from npmjs because regional mirrors may omit the native .node file.
RUN npm install --global --registry=https://registry.npmjs.org \
    node-addon-require-builtin-linux-x64-gnu@0.1.9 \
    && test -s "$(npm root --global)/node-addon-require-builtin-linux-x64-gnu/prebuilt/linux-x64-gnu-napi-v9.node"

COPY docker/dsh-entrypoint.sh /usr/local/bin/dsh-entrypoint
RUN chmod +x /usr/local/bin/dsh-entrypoint \
    && mkdir -p /home/node/.dsh /workspace \
    && chown -R node:node /home/node/.dsh /workspace

ENV DSH_HOME=/home/node/.dsh
USER node
WORKDIR /workspace
VOLUME ["/home/node/.dsh", "/workspace"]
EXPOSE 3080

ENTRYPOINT ["/usr/local/bin/dsh-entrypoint"]
