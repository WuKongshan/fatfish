# ===== DeepSeek（必填）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
BOT_MODEL=deepseek-chat

# ===== QQ 机器人（不填则不连 QQ）=====
# q.qq.com → 你的机器人 → 开发设置
QQ_APP_ID=
QQ_APP_SECRET=
BOT_NAME=大肥鱼

# ===== 微信公众号（不填则不启动 HTTP 服务）=====
WECHAT_TOKEN=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_ACK_TEXT=收到，正在想…
WECHAT_PORT=80

# ===== 网页桌宠：DSH Web + dsh-pet =====
PUBLIC_IP=43.138.189.204

# ===== 生图：zhipu / ark / siliconflow =====
IMAGE_PROVIDER=zhipu
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_SIZE=1024x1024

# ===== 联网搜索：off / tavily / bocha =====
WEB_SEARCH_PROVIDER=off
WEB_SEARCH_API_KEY=

# ===== 行为 =====
HISTORY_TURNS=10
BOT_TIMEZONE=Asia/Shanghai
REMINDER_DB=data/bot.db
REMINDER_SCAN_SECONDS=30
